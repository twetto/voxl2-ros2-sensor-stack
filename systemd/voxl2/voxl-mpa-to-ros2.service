[Unit]
Description=VOXL2 MPA to ROS 2 bridge
Requires=voxl-test2.service voxl-camera-server.service
After=network-online.target voxl-test2.service voxl-camera-server.service
PartOf=voxl-sensors.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/root
Environment=HOME=/home/root
Environment=ROS_DOMAIN_ID=0
Environment=ROS_LOCALHOST_ONLY=0
Environment=RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ExecStartPre=/bin/bash -c 'until [ -p /run/mpa/tracking_front_misp_encoded/request ]; do sleep 0.2; done'
ExecStartPre=/usr/bin/timeout 30 /usr/bin/voxl-inspect-cam tracking_front_misp_encoded -t
ExecStart=/bin/bash -lc 'source /opt/ros/foxy/setup.bash && source /opt/ros/foxy/mpa_to_ros2/install/setup.bash && exec ros2 run voxl_mpa_to_ros2 voxl_mpa_to_ros2_node'
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStartSec=90
TimeoutStopSec=10
